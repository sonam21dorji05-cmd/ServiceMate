<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.servicemate.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.servicemate.ui.signup.SignupFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup">

        <action
            android:id="@+id/action_signupFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.servicemate.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_homeFragment_to_addVehicleFragment"
            app:destination="@id/addVehicleFragment" />

        <action
            android:id="@+id/action_homeFragment_to_vehicleDetailFragment"
            app:destination="@id/vehicleDetailFragment" />

        <action
            android:id="@+id/action_homeFragment_to_remindersFragment"
            app:destination="@id/remindersFragment" />
    </fragment>

    <fragment
        android:id="@+id/remindersFragment"
        android:name="com.example.servicemate.ui.reminders.RemindersFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminders" />

    <fragment
        android:id="@+id/addVehicleFragment"
        android:name="com.example.servicemate.ui.addvehicle.AddVehicleFragment"
        android:label="Add Vehicle"
        tools:layout="@layout/fragment_add_vehicle" />

    <fragment
        android:id="@+id/vehicleDetailFragment"
        android:name="com.example.servicemate.ui.vehicledetail.VehicleDetailFragment"
        android:label="Vehicle Detail"
        tools:layout="@layout/fragment_vehicle_detail">

        <argument
            android:name="vehicleId"
            app:argType="long" />

        <action
            android:id="@+id/action_vehicleDetailFragment_to_logMaintenanceFragment"
            app:destination="@id/logMaintenanceFragment" />
    </fragment>

    <fragment
        android:id="@+id/logMaintenanceFragment"
        android:name="com.example.servicemate.ui.logmaintenance.LogMaintenanceFragment"
        android:label="Log Maintenance"
        tools:layout="@layout/fragment_log_maintenance">

        <argument
            android:name="vehicleId"
            app:argType="long" />
    </fragment>

</navigation>